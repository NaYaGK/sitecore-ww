<?xml version="1.0"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <linkManager>
      <providers>
        <add name="localizedProvider"
             patch:attribute="useDisplayName"
             useDisplayName="true" />
      </providers>
    </linkManager>
  </sitecore>
</configuration>
