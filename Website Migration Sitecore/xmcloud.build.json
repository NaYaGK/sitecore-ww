{
  "renderingHosts": {
    "workwear": {
      "path": "./cws-xm-cloud-app",
      "nodeVersion": "22.11.0",
      "enabled": false,
      "type": "sxa",
      "buildCommand": "build",
      "runCommand": "next:start"
    },
    "healthcare": {
      "path": "./cws-xm-cloud-app",
      "nodeVersion": "22.11.0",
      "enabled": false,
      "type": "sxa",
      "buildCommand": "build",
      "runCommand": "next:start"
    },
    "cws": {
      "path": "./cws-xm-cloud-app",
      "nodeVersion": "22.11.0",
      "enabled": false,
      "type": "sxa",
      "buildCommand": "build",
      "runCommand": "next:start"
    }
  },
  "postActions": {
